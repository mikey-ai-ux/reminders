@page "/reset-password"
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager

<PageTitle>Choose a new password — Reminders</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon"><Icon Name="lock" Size="26" /></div>
            <h1>Choose a new password</h1>
            <p>At least 8 characters, including a number.</p>
        </div>

        @if (succeeded)
        {
            <div class="alert alert-success"><Icon Name="check-circle" Size="16" /> Your password has been changed.</div>
            <a href="/login" class="btn btn-primary btn-full">Sign in</a>
        }
        else if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Code))
        {
            <div class="alert alert-error" role="alert"><Icon Name="alert-triangle" Size="16" /> This reset link is incomplete. Request a new one.</div>
            <a href="/forgot-password" class="btn btn-secondary btn-full">Request a new link</a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error" role="alert"><Icon Name="alert-triangle" Size="16" /> @errorMessage</div>
            }

            <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="reset-password">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label for="reset-new">New password</label>
                    <InputText id="reset-new" @bind-Value="model.Password" type="password" class="form-input" autocomplete="new-password" />
                    <ValidationMessage For="() => model.Password" />
                </div>
                <div class="form-group">
                    <label for="reset-confirm">Repeat new password</label>
                    <InputText id="reset-confirm" @bind-Value="model.ConfirmPassword" type="password" class="form-input" autocomplete="new-password" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>
                <button type="submit" class="btn btn-primary btn-full">Change password</button>
            </EditForm>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    [SupplyParameterFromForm]
    private ResetModel model { get; set; } = new();

    private bool succeeded;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        var user = string.IsNullOrWhiteSpace(UserId) ? null : await UserManager.FindByIdAsync(UserId);
        if (user is null || string.IsNullOrWhiteSpace(Code))
        {
            errorMessage = "This reset link is invalid or has expired. Request a new one.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Code, model.Password);
        if (result.Succeeded)
        {
            succeeded = true;
            return;
        }

        errorMessage = result.Errors.Any(e => e.Code == "InvalidToken")
            ? "This reset link is invalid or has expired. Request a new one."
            : string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter a new password.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string Password { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
