@page "/reminders"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject IReminderService ReminderSvc
@inject UserManager<AppUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IVerificationSender VerificationSender
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject Reminders.Data.AppDbContext Db
@rendermode InteractiveServer

<PageTitle>Reminders</PageTitle>

<div class="page-head">
    <div>
        <h1>Reminders</h1>
        <p class="page-subtitle">@Summary</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowNewForm" disabled="@AtLimit"><Icon Name="plus" Size="16" /> New reminder</button>
</div>

@if (!isLoading && currentUser is not null)
{
    @if (!currentUser.EmailConfirmed && !string.IsNullOrWhiteSpace(currentUser.Email))
    {
        <div class="notice">
            <Icon Name="mail" Size="18" />
            <div class="notice-text">
                <strong>Confirm your email to get reminders by email.</strong>
                <span>We'll send a link to @currentUser.Email.</span>
                @if (!string.IsNullOrWhiteSpace(confirmStatus))
                {
                    <span class="notice-status">@confirmStatus</span>
                }
                @if (!string.IsNullOrWhiteSpace(devConfirmLink))
                {
                    <a href="@devConfirmLink">Open confirmation link (development only)</a>
                }
            </div>
            <button class="btn btn-sm btn-secondary" @onclick="SendConfirmation" disabled="@sendingConfirmation">@(sendingConfirmation ? "Sending…" : "Send link")</button>
        </div>
    }

    <form class="quick-add" @onsubmit="QuickAdd">
        <span class="quick-add-icon"><Icon Name="sparkles" Size="18" /></span>
        <input class="quick-add-input" @bind="quickName" @bind:event="oninput" placeholder="Remind me to…" maxlength="200" aria-label="What to be reminded about" disabled="@AtLimit" />
        <select class="quick-add-when" @bind="quickWhen" aria-label="When" disabled="@AtLimit">
            <option value="hour">In 1 hour</option>
            <option value="evening">This evening</option>
            <option value="tomorrow">Tomorrow morning</option>
            <option value="monday">Next Monday</option>
            <option value="custom">Pick date &amp; time…</option>
        </select>
        <button type="submit" class="btn btn-primary" disabled="@(AtLimit || quickBusy || string.IsNullOrWhiteSpace(quickName))">Add</button>
    </form>
    @if (!string.IsNullOrWhiteSpace(quickError))
    {
        <div class="alert alert-error" role="alert"><Icon Name="alert-triangle" Size="16" /> @quickError</div>
    }
    @if (!string.IsNullOrWhiteSpace(quickInfo))
    {
        <div class="alert alert-success"><Icon Name="check-circle" Size="16" /> @quickInfo</div>
    }

    @if (currentUser.SubscriptionTier == SubscriptionTier.Free)
    {
        <div class="usage">
            <div class="usage-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@FreeLimit" aria-valuenow="@activeCount" aria-label="Active reminders used on the Free plan">
                <span class="@(activeCount >= FreeLimit ? "full" : activeCount >= FreeLimit - 2 ? "warn" : "")" style="width:@(Math.Min(100, activeCount * 100 / FreeLimit))%"></span>
            </div>
            <span class="usage-text">@activeCount of @FreeLimit active reminders on the Free plan</span>
            @if (AtLimit)
            {
                <a href="/profile/subscription" class="usage-link">Upgrade for unlimited</a>
            }
        </div>
    }
}

@if (showForm)
{
    <div class="modal-overlay" @onclick="HideForm">
        <div class="modal-card" @onclick:stopPropagation>
            <ReminderForm @key="formKey" Reminder="editingReminder" Template="templateReminder" CurrentUser="currentUser" OnSaved="OnReminderSaved" OnCancel="HideForm" />
        </div>
    </div>
}

@if (showForm || showDeleteConfirm)
{
    <style>
        body { overflow: hidden !important; }
    </style>
}

@if (showDeleteConfirm && pendingDeleteReminder is not null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="confirm-card" @onclick:stopPropagation>
            <h3>Delete reminder?</h3>
            <p>
                This will delete <strong>@pendingDeleteReminder.Name</strong> and cannot be undone.
            </p>
            <div class="confirm-actions">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading reminders...</p>
    </div>
}
else if (reminders.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon"><Icon Name="inbox" Size="34" Stroke="1.6" /></div>
        <h2>No reminders yet</h2>
        <p>Type what you need to remember in the box above, or set one up with all the options.</p>
        <button class="btn btn-primary" @onclick="ShowNewForm"><Icon Name="plus" Size="16" /> New reminder</button>
    </div>
}
else
{
    @if (reminders.Count > 5)
    {
        <div class="list-search">
            <Icon Name="search" Size="16" />
            <input @bind="search" @bind:event="oninput" placeholder="Search reminders" aria-label="Search reminders" />
        </div>
    }

    @if (!Upcoming.Any() && !Paused.Any() && !Past.Any())
    {
        <p class="muted">No reminders match "@search".</p>
    }

    @if (Upcoming.Any())
    {
        <h2 class="list-heading">Upcoming <span class="count">@Upcoming.Count()</span></h2>
        <div class="reminder-list">
            @foreach (var reminder in Upcoming)
            {
                <ReminderCard @key="reminder.Id" Reminder="reminder" OnEdit="EditReminder" OnPause="PauseReminder" OnResume="ResumeReminder" OnDuplicate="DuplicateReminder" OnDelete="DeleteReminder" OnDone="MarkDone" />
            }
        </div>
    }

    @if (Paused.Any())
    {
        <h2 class="list-heading">Paused <span class="count">@Paused.Count()</span></h2>
        <div class="reminder-list">
            @foreach (var reminder in Paused)
            {
                <ReminderCard @key="reminder.Id" Reminder="reminder" OnEdit="EditReminder" OnPause="PauseReminder" OnResume="ResumeReminder" OnDuplicate="DuplicateReminder" OnDelete="DeleteReminder" OnDone="MarkDone" />
            }
        </div>
    }

    @if (Past.Any())
    {
        <button class="list-heading list-heading-toggle" @onclick="() => showPast = !showPast" aria-expanded="@showPast">
            Done <span class="count">@Past.Count()</span>
            <Icon Name="chevron-down" Size="16" Class="@(showPast ? "flip" : "")" />
        </button>
        @if (showPast)
        {
            <div class="reminder-list">
                @foreach (var reminder in Past)
                {
                    <ReminderCard @key="reminder.Id" Reminder="reminder" OnEdit="EditReminder" OnPause="PauseReminder" OnResume="ResumeReminder" OnDuplicate="DuplicateReminder" OnDelete="DeleteReminder" OnDone="MarkDone" />
                }
            </div>
        }
    }
}

@code {
    private const int FreeLimit = ReminderService.FreeReminderLimit;

    private List<Reminder> reminders = new();
    private AppUser? currentUser;
    private bool isLoading = true;

    private bool showForm;
    private int formKey;
    private Reminder? editingReminder;
    private Reminder? templateReminder;

    private bool showDeleteConfirm;
    private Reminder? pendingDeleteReminder;

    private string search = string.Empty;
    private bool showPast;

    private string quickName = string.Empty;
    private string quickWhen = "hour";
    private bool quickBusy;
    private string? quickError;
    private string? quickInfo;

    private bool sendingConfirmation;
    private string? confirmStatus;
    private string? devConfirmLink;

    // Only reminders that can still fire count towards the Free plan limit.
    private int activeCount => reminders.Count(r => r.IsActive);
    private bool AtLimit => currentUser?.SubscriptionTier == SubscriptionTier.Free && activeCount >= FreeLimit;

    private IEnumerable<Reminder> Matching => string.IsNullOrWhiteSpace(search)
        ? reminders
        : reminders.Where(r => r.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                            || (r.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    // A finished one-time reminder that was snoozed is still coming up, at its snooze time.
    private static bool IsSnoozed(Reminder r) => r.SnoozedUntil is { } until && until > DateTime.UtcNow;
    private static DateTime NextTime(Reminder r) => IsSnoozed(r) && (!r.IsActive || r.SnoozedUntil < r.OccursAt) ? r.SnoozedUntil!.Value : r.OccursAt;

    private IEnumerable<Reminder> Upcoming => Matching.Where(r => !r.IsPaused && (r.IsActive || IsSnoozed(r))).OrderBy(NextTime);
    private IEnumerable<Reminder> Paused => Matching.Where(r => r.IsActive && r.IsPaused).OrderBy(r => r.OccursAt);
    private IEnumerable<Reminder> Past => Matching.Where(r => !r.IsActive && !IsSnoozed(r)).OrderByDescending(r => r.OccursAt);

    private string Summary
    {
        get
        {
            if (isLoading) return "Loading…";
            var next = reminders.Where(r => r.IsActive && !r.IsPaused).OrderBy(r => r.OccursAt).FirstOrDefault();
            return next is null
                ? "Nothing scheduled. Add your first reminder below."
                : $"Next up: {next.Name}, {TimeText.DayInline(next.OccursAt, next.TimeZoneId, DateTime.UtcNow)}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(authState.User);
        await ReloadAsync();
        isLoading = false;
    }

    private async Task ReloadAsync()
    {
        if (currentUser != null) reminders = await ReminderSvc.GetUserRemindersAsync(currentUser.Id);
    }

    void ShowNewForm() => OpenForm(null, null);
    void EditReminder(Reminder r) => OpenForm(r, null);
    void DuplicateReminder(Reminder r) => OpenForm(null, r);
    void HideForm() => showForm = false;

    private void OpenForm(Reminder? edit, Reminder? template)
    {
        editingReminder = edit;
        templateReminder = template;
        formKey++; // a fresh form each time, so nothing leaks from the previous one
        quickError = quickInfo = null;
        showForm = true;
    }

    async Task OnReminderSaved()
    {
        showForm = false;
        await ReloadAsync();
    }

    private async Task QuickAdd()
    {
        if (currentUser is null || quickBusy || string.IsNullOrWhiteSpace(quickName)) return;
        quickError = quickInfo = null;

        if (quickWhen == "custom")
        {
            OpenForm(null, new Reminder { Name = quickName.Trim(), RecurringInterval = RecurrenceCalculator.None, OccursAt = default, TimeZoneId = TimeZoneOptions.Normalize(currentUser.TimeZoneId) });
            quickName = string.Empty;
            quickWhen = "hour";
            return;
        }

        quickBusy = true;
        try
        {
            var tzId = TimeZoneOptions.Normalize(currentUser.TimeZoneId);
            var tz = RecurrenceCalculator.ResolveTimeZone(tzId);
            var local = QuickTimes.Resolve(quickWhen, TimeZoneOptions.NowIn(tzId));

            var reminder = new Reminder
            {
                UserId = currentUser.Id,
                Name = quickName.Trim(),
                Icon = "bell",
                OccursAt = RecurrenceCalculator.ToUtc(local, tz),
                TimeZoneId = tzId,
                RecurringInterval = RecurrenceCalculator.None
            };

            // Deliver the same way a new reminder in the full form would: confirmed email plus registered devices.
            var contact = Db.Users.AsNoTracking().Where(u => u.Id == currentUser.Id).Select(u => new { u.Email, u.EmailConfirmed }).FirstOrDefault();
            if (contact is { EmailConfirmed: true } && !string.IsNullOrWhiteSpace(contact.Email))
            {
                reminder.Channels.Add(new ReminderChannel { Channel = NotificationChannel.Email });
                reminder.Targets.Add(new ReminderTarget { Channel = NotificationChannel.Email, TargetType = "EmailAddress", TargetValue = contact.Email, Label = contact.Email });
            }

            var devices = Db.PushSubscriptions.AsNoTracking().Where(p => p.UserId == currentUser.Id).OrderByDescending(p => p.CreatedAt).ToList();
            if (devices.Count > 0)
            {
                reminder.Channels.Add(new ReminderChannel { Channel = NotificationChannel.Push });
                var n = 1;
                foreach (var d in devices)
                    reminder.Targets.Add(new ReminderTarget { Channel = NotificationChannel.Push, TargetType = "PushDevice", TargetValue = d.Endpoint, Label = $"{(string.IsNullOrWhiteSpace(d.DeviceType) ? "Device" : d.DeviceType)} #{n++}" });
            }

            await ReminderSvc.CreateAsync(reminder);
            var when = TimeText.DayInline(reminder.OccursAt, tzId, DateTime.UtcNow);
            quickInfo = reminder.Channels.Count == 0
                ? $"Added for {when}. It has no way to notify you yet: confirm your email or register a device, then edit it."
                : $"Added for {when}.";
            quickName = string.Empty;
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            quickError = ex.Message;
        }
        finally
        {
            quickBusy = false;
        }
    }

    private async Task SendConfirmation()
    {
        if (currentUser is null || string.IsNullOrWhiteSpace(currentUser.Email) || sendingConfirmation) return;
        sendingConfirmation = true;
        try
        {
            var token = await UserManager.GenerateEmailConfirmationTokenAsync(currentUser);
            var link = $"{Nav.BaseUri}confirm-email?userId={Uri.EscapeDataString(currentUser.Id)}&code={Uri.EscapeDataString(token)}";
            var sent = await VerificationSender.SendEmailAsync(currentUser.Email, "Confirm your Reminders email", $"Please confirm your email by opening this link: {link}");

            devConfirmLink = !sent && Env.IsDevelopment() ? link : null;
            confirmStatus = sent
                ? "Sent. Open the link in the email, then refresh this page."
                : Env.IsDevelopment()
                    ? "Email delivery is not set up on this server."
                    : "The email could not be sent. Email delivery is not set up on this server yet.";
        }
        finally
        {
            sendingConfirmation = false;
        }
    }

    // Reload after each change: resuming can move a recurring reminder to its next date,
    // and the scheduler may have changed other reminders in the meantime.
    async Task PauseReminder(int id)
    {
        if (currentUser == null) return;
        await ReminderSvc.PauseAsync(id, currentUser.Id);
        await ReloadAsync();
    }

    async Task ResumeReminder(int id)
    {
        if (currentUser == null) return;
        await ReminderSvc.ResumeAsync(id, currentUser.Id);
        await ReloadAsync();
    }

    // Done from the list means "I've dealt with it": a one-time reminder is finished,
    // a repeating one skips ahead to its next occurrence.
    async Task MarkDone(int id)
    {
        if (currentUser == null) return;
        await ReminderSvc.MarkDoneAsync(id, currentUser.Id, skipUpcoming: true);
        await ReloadAsync();
    }

    Task DeleteReminder(int id)
    {
        pendingDeleteReminder = reminders.FirstOrDefault(r => r.Id == id);
        showDeleteConfirm = pendingDeleteReminder is not null;
        return Task.CompletedTask;
    }

    async Task ConfirmDelete()
    {
        if (pendingDeleteReminder is null || currentUser is null) return;

        await ReminderSvc.DeleteAsync(pendingDeleteReminder.Id, currentUser.Id);
        pendingDeleteReminder = null;
        showDeleteConfirm = false;
        await ReloadAsync();
    }

    void CancelDelete()
    {
        pendingDeleteReminder = null;
        showDeleteConfirm = false;
    }
}
