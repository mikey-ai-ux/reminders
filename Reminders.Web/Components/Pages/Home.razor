@page "/"
<PageTitle>Reminders — Never Forget Anything</PageTitle>

@if (Account == "deleted")
{
    <div class="alert alert-success" role="status"><Icon Name="check-circle" Size="16" /> Your account and all its data have been deleted.</div>
}

<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge"><Icon Name="sparkles" Size="14" /> Free to get started</div>
        <h1 class="hero-title">Never miss a thing<br /><span class="gradient-text">with smart reminders</span></h1>
        <p class="hero-subtitle">Type what you need to remember, pick a time, and get an email, push notification, text or call exactly when it matters, in your own timezone.</p>
        <div class="hero-actions">
            <AuthorizeView>
                <Authorized>
                    <a href="/reminders" class="btn btn-primary btn-lg"><Icon Name="bell" Size="17" /> My reminders</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/register" class="btn btn-primary btn-lg">Get started free <Icon Name="arrow-right" Size="17" /></a>
                    <a href="/login" class="btn btn-secondary btn-lg">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="hero-card">
            <div class="hero-quick"><Icon Name="sparkles" Size="16" /><span>Remind me to call the dentist</span><span class="hero-quick-when">Tomorrow morning</span></div>
            <div class="reminder-preview">
                <div class="rp-icon"><Icon Name="briefcase" Size="18" /></div>
                <div class="rp-content">
                    <div class="rp-name">Team standup</div>
                    <div class="rp-time">Today at 9:00 AM · every day</div>
                </div>
                <div class="rp-badge active">Active</div>
            </div>
            <div class="reminder-preview">
                <div class="rp-icon"><Icon Name="pill" Size="18" /></div>
                <div class="rp-content">
                    <div class="rp-name">Take medication</div>
                    <div class="rp-time">Today at 8:00 PM · every day</div>
                </div>
                <div class="rp-badge active">Active</div>
            </div>
            <div class="reminder-preview">
                <div class="rp-icon"><Icon Name="home" Size="18" /></div>
                <div class="rp-content">
                    <div class="rp-name">Pay rent</div>
                    <div class="rp-time">1st at 9:00 AM · every month</div>
                </div>
                <div class="rp-badge paused">Paused</div>
            </div>
        </div>
    </div>
</section>

<section class="features-section">
    <h2 class="section-title">Everything you need to stay on track</h2>
    <div class="features-grid">
        @foreach (var f in Features)
        {
            <div class="feature-card">
                <div class="feature-icon"><Icon Name="@f.Icon" Size="22" /></div>
                <h3>@f.Title</h3>
                <p>@f.Text</p>
            </div>
        }
    </div>
</section>

<section class="pricing-section">
    <h2 class="section-title">Simple, transparent pricing</h2>
    <div class="pricing-grid">
        @foreach (var plan in Plans)
        {
            <div class="pricing-card @(plan.Featured ? "featured" : "")">
                @if (plan.Featured)
                {
                    <div class="plan-badge">Most popular</div>
                }
                <div class="plan-name">@plan.Name</div>
                <div class="plan-price">@plan.Price <span class="plan-period">/ month</span></div>
                <ul class="plan-features">
                    @foreach (var item in plan.Items)
                    {
                        <li class="@(item.Included ? "" : "excluded")"><Icon Name="@(item.Included ? "check" : "x")" Size="15" Stroke="2.6" /> @item.Text</li>
                    }
                </ul>
                <AuthorizeView>
                    <NotAuthorized>
                        <a href="/register" class="btn @(plan.Paid ? "btn-primary" : "btn-secondary") btn-full">@(plan.Paid ? $"Choose {plan.Name}" : "Get started free")</a>
                    </NotAuthorized>
                    <Authorized>
                        <a href="@(plan.Paid ? "/profile/subscription" : "/reminders")" class="btn @(plan.Paid ? "btn-primary" : "btn-secondary") btn-full">@(plan.Paid ? $"Choose {plan.Name}" : "Go to reminders")</a>
                    </Authorized>
                </AuthorizeView>
            </div>
        }
    </div>
</section>

<style>
.hero-section { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; align-items: center; padding: 4rem 0 3.5rem; }
.hero-badge { display: inline-flex; align-items: center; gap: 0.4rem; background: var(--color-primary-alpha); color: var(--color-primary); padding: 0.35rem 0.9rem; border-radius: 20px; font-size: 0.82rem; font-weight: 600; margin-bottom: 1.25rem; }
.hero-title { font-family: 'Plus Jakarta Sans', inherit; font-size: 3.1rem; font-weight: 800; line-height: 1.1; letter-spacing: -0.03em; margin: 0 0 1.1rem; color: var(--color-text); }
.gradient-text { background: linear-gradient(135deg, var(--color-primary), #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.hero-subtitle { font-size: 1.08rem; color: var(--color-text-muted); margin-bottom: 1.9rem; line-height: 1.65; max-width: 520px; }
.hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
.hero-visual { display: flex; justify-content: center; }
.hero-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 20px; padding: 1.1rem; width: 100%; max-width: 380px; display: flex; flex-direction: column; gap: 0.6rem; box-shadow: var(--shadow-lg); }
.hero-quick { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.75rem; border: 1.5px solid var(--color-primary); border-radius: 12px; font-size: 0.85rem; color: var(--color-text); box-shadow: 0 0 0 3px var(--color-primary-alpha); }
.hero-quick .icon { color: var(--color-primary); }
.hero-quick span:first-of-type { flex: 1; }
.hero-quick-when { font-size: 0.72rem; color: var(--color-text-muted); background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: 8px; padding: 0.15rem 0.45rem; white-space: nowrap; }
.reminder-preview { display: flex; align-items: center; gap: 0.8rem; padding: 0.7rem; border: 1px solid var(--color-border); background: var(--color-surface-2); border-radius: 12px; }
.rp-icon { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: var(--color-primary-alpha); color: var(--color-primary); }
.rp-content { flex: 1; min-width: 0; }
.rp-name { font-weight: 700; font-size: 0.9rem; color: var(--color-text); }
.rp-time { font-size: 0.76rem; color: var(--color-text-muted); margin-top: 1px; }
.rp-badge { font-size: 0.66rem; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
.rp-badge.active { background: rgba(34,197,94,0.14); color: var(--color-success); }
.rp-badge.paused { background: rgba(234,179,8,0.14); color: var(--color-warning); }
.features-section { padding: 3.5rem 0; }
.section-title { text-align: center; font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 2.25rem; color: var(--color-text); }
.features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
.feature-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px; padding: 1.5rem; transition: border-color 0.15s, transform 0.15s; }
.feature-card:hover { border-color: var(--color-primary); transform: translateY(-2px); }
.feature-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: var(--color-primary-alpha); color: var(--color-primary); margin-bottom: 0.9rem; }
.feature-card h3 { font-size: 1rem; font-weight: 700; margin: 0 0 0.4rem; color: var(--color-text); }
.feature-card p { font-size: 0.875rem; color: var(--color-text-muted); margin: 0; line-height: 1.6; }
.pricing-section { padding: 3.5rem 0 4.5rem; }
.pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(235px, 1fr)); gap: 1.1rem; }
.pricing-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 18px; padding: 1.75rem; position: relative; display: flex; flex-direction: column; }
.pricing-card.featured { border-color: var(--color-primary); box-shadow: 0 0 0 1px var(--color-primary), var(--shadow-md); }
.plan-badge { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); background: var(--color-primary); color: #fff; padding: 0.2rem 0.9rem; border-radius: 20px; font-size: 0.7rem; font-weight: 700; white-space: nowrap; }
.plan-name { font-size: 1.05rem; font-weight: 700; color: var(--color-text-muted); margin-bottom: 0.35rem; }
.plan-price { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.02em; color: var(--color-text); margin-bottom: 1.25rem; }
.plan-period { font-size: 0.9rem; font-weight: 400; color: var(--color-text-muted); letter-spacing: 0; }
.plan-features { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: 0.55rem; flex: 1; }
.plan-features li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; color: var(--color-text); }
.plan-features li .icon { color: var(--color-success); }
.plan-features li.excluded { color: var(--color-text-muted); }
.plan-features li.excluded .icon { color: var(--color-text-subtle); }
.btn-full { width: 100%; }
@@media (max-width: 900px) {
    .hero-section { grid-template-columns: 1fr; gap: 2rem; padding: 2.5rem 0 2rem; }
    .hero-title { font-size: 2.2rem; }
    .features-grid { grid-template-columns: 1fr 1fr; }
}
@@media (max-width: 560px) {
    .features-grid { grid-template-columns: 1fr; }
}
</style>

@code {
    [SupplyParameterFromQuery(Name = "account")]
    public string? Account { get; set; }

    private sealed record Feature(string Icon, string Title, string Text);
    private sealed record PlanItem(string Text, bool Included = true);
    private sealed record Plan(string Name, string Price, bool Paid, bool Featured, PlanItem[] Items);

    private static readonly Feature[] Features =
    [
        new("zap", "Add one in seconds", "Type it, tap \"Tomorrow morning\", done. Open the full form only when you need more."),
        new("mail", "Email reminders", "Timely emails for the things that matter. Included on the Free plan."),
        new("bell-ring", "Push notifications", "Browser and phone notifications, even when the app is closed. Included on Free."),
        new("message-square", "Texts and calls", "Critical reminders by SMS or phone call on the Starter, Growth and Scale plans."),
        new("repeat", "Repeating schedules", "Every day, week, month or year, or on the weekdays you choose."),
        new("globe", "Timezone aware", "Reminders fire at the right local time, including across daylight-saving changes.")
    ];

    private static readonly Plan[] Plans =
    [
        new("Free", "$0", false, false, [new("Up to 10 active reminders"), new("Email notifications"), new("Push notifications"), new("Texts (SMS)", false), new("Phone calls", false)]),
        new("Starter", "$9.99", true, false, [new("Unlimited reminders"), new("Email + push"), new("100 texts / month"), new("10 phone calls / month")]),
        new("Growth", "$29.99", true, true, [new("Unlimited reminders"), new("Email + push"), new("2,000 texts / month"), new("200 phone calls / month")]),
        new("Scale", "$99.99", true, false, [new("Unlimited reminders"), new("Email + push"), new("10,000 texts / month"), new("1,000 phone calls / month")])
    ];
}
