@page "/forgot-password"
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject IVerificationSender VerificationSender
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

<PageTitle>Reset your password — Reminders</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon"><Icon Name="key" Size="26" /></div>
            <h1>Forgot your password?</h1>
            <p>Enter your email and we'll send you a link to choose a new one.</p>
        </div>

        @if (done)
        {
            <div class="alert alert-success"><Icon Name="check-circle" Size="16" /> If an account exists for that address, a reset link is on its way. It works for a limited time.</div>
            @if (!string.IsNullOrWhiteSpace(devLink))
            {
                <div class="alert alert-info">Email delivery is not set up on this server. <a href="@devLink">Open the reset link (development only)</a></div>
            }
            else if (sendFailed)
            {
                <div class="alert alert-error" role="alert"><Icon Name="alert-triangle" Size="16" /> The email could not be sent because email delivery is not set up on this server yet.</div>
            }
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="forgot-password">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label for="forgot-email">Email</label>
                    <InputText id="forgot-email" @bind-Value="model.Email" type="email" class="form-input" placeholder="you@example.com" autocomplete="username" />
                    <ValidationMessage For="() => model.Email" />
                </div>
                <button type="submit" class="btn btn-primary btn-full">Send reset link</button>
            </EditForm>
        }

        <p class="auth-footer"><a href="/login">Back to sign in</a></p>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private ForgotModel model { get; set; } = new();

    private bool done;
    private bool sendFailed;
    private string? devLink;

    private async Task HandleSubmit()
    {
        // Same answer whether or not the account exists, so this page can't be used to discover who has one.
        done = true;

        var user = await UserManager.FindByEmailAsync(model.Email.Trim());
        if (user is null || string.IsNullOrWhiteSpace(user.Email)) return;

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var link = $"{Nav.BaseUri}reset-password?userId={Uri.EscapeDataString(user.Id)}&code={Uri.EscapeDataString(token)}";
        var sent = await VerificationSender.SendEmailAsync(user.Email, "Reset your Reminders password",
            $"Someone asked to reset the password for your Reminders account. Open this link to choose a new one: {link}\n\nIf this wasn't you, ignore this email.");

        if (!sent)
        {
            // The link proves ownership of the mailbox, so it is only ever shown on screen in Development.
            if (Env.IsDevelopment()) devLink = link;
            else sendFailed = !VerificationSender.IsEmailConfigured;
        }
    }

    private sealed class ForgotModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your email address.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";
    }
}
