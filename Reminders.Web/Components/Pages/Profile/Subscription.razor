@page "/profile/subscription"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject ISubscriptionService SubSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Subscription — Reminders</PageTitle>

<div class="tab-content card">
    <h2>Subscription Management</h2>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-error" role="alert">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(infoMessage))
    {
        <div class="alert alert-success">@infoMessage</div>
    }
    @if (!SubSvc.IsBillingConfigured)
    {
        <div class="alert alert-info">Online payments are not set up on this server yet, so plans can't be changed here.</div>
    }

    <div class="current-plan">
        <div class="plan-info">
            <span class="tier-badge-lg tier-@(currentUser?.SubscriptionTier.ToString().ToLower())">
                @CurrentPlanName Plan
            </span>
            @if (currentUser?.SubscriptionExpiresAt != null && IsPaid)
            {
                <p class="expiry">Renews @currentUser.SubscriptionExpiresAt.Value.ToString("MMMM d, yyyy")</p>
            }
        </div>
    </div>

    <div class="plans-grid">
        @foreach (var p in plans)
        {
            var isCurrent = currentPlan?.Id == p.Id;
            <div class="plan-card @(p.Highlight ? "highlight" : "")">
                <h3>@p.Name</h3>
                <div class="price">$@p.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)<span>/month</span></div>
                <ul>
                    <li>Unlimited reminders</li>
                    <li>Email + Push included</li>
                    <li>@p.SmsLimit.ToString("N0") SMS / month</li>
                    <li>@p.VoiceLimit.ToString("N0") voice calls / month</li>
                </ul>
                @if (isCurrent)
                {
                    <button class="btn btn-secondary" disabled>Current plan</button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="() => Upgrade(p.Id)" disabled="@(busy || !SubSvc.IsBillingConfigured)">Choose @p.Name</button>
                }
            </div>
        }
    </div>

    @if (IsPaid)
    {
        <div class="manage-sub">
            <button class="btn btn-secondary" @onclick="ManageBilling" disabled="@(busy || !SubSvc.IsBillingConfigured)">Manage or cancel subscription</button>
        </div>
    }
</div>
<style>
.current-plan { display: flex; align-items: center; margin-bottom: 1.5rem; }
.tier-badge-lg { font-size: 0.9rem; font-weight: 700; padding: 5px 14px; border-radius: 20px; }
.tier-free { background: var(--color-border); color: var(--color-text-muted); }
.tier-pro,.tier-business,.tier-enterprise { background: rgba(67,97,238,0.15); color: var(--color-primary); }
.expiry { color: var(--color-text-muted); font-size: 0.85rem; margin: 0.5rem 0 0; }
.plans-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap:1rem; }
.plan-card { border:1px solid var(--color-border); border-radius:12px; background:var(--color-surface); padding:1rem; }
.plan-card.highlight { border-color: var(--color-primary); box-shadow: 0 4px 18px rgba(67,97,238,.15); }
.plan-card h3 { margin:0 0 .5rem; }
.price { font-size:1.5rem; font-weight:800; margin-bottom:.6rem; }
.price span { font-size:.85rem; color:var(--color-text-muted); font-weight:400; }
.plan-card ul { margin:.3rem 0 1rem; padding-left:1rem; color:var(--color-text-muted); }
.manage-sub { margin-top:1rem; text-align:right; }
</style>

@code {
    private AppUser? currentUser;
    private SubscriptionPlan? currentPlan;
    private string? errorMessage;
    private string? infoMessage;
    private bool busy;

    [SupplyParameterFromQuery(Name = "success")]
    public string? Success { get; set; }

    [SupplyParameterFromQuery(Name = "cancelled")]
    public string? Cancelled { get; set; }

    private bool IsPaid => currentUser is not null && currentUser.SubscriptionTier != Reminders.Models.Enums.SubscriptionTier.Free;
    private string CurrentPlanName => currentPlan?.Name ?? currentUser?.SubscriptionTier.ToString() ?? "Free";

    private readonly List<PlanOption> plans =
    [
        new() { Id = 2, Name = "Starter", Price = 9.99m, SmsLimit = 100, VoiceLimit = 10 },
        new() { Id = 3, Name = "Growth", Price = 29.99m, SmsLimit = 2000, VoiceLimit = 200, Highlight = true },
        new() { Id = 4, Name = "Scale", Price = 99.99m, SmsLimit = 10000, VoiceLimit = 1000 }
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(authState.User);
        if (currentUser is not null)
            currentPlan = await SubSvc.GetCurrentPlanAsync(currentUser);

        if (Success == "true")
            infoMessage = "Payment received. Your new plan becomes active as soon as the payment is confirmed, usually within a minute.";
        else if (Cancelled == "true")
            infoMessage = "Checkout was cancelled. Your plan has not changed.";
    }

    private async Task Upgrade(int planId)
    {
        if (currentUser == null || busy) return;
        busy = true;
        errorMessage = null;
        try
        {
            var page = $"{Nav.BaseUri}profile/subscription";
            var url = await SubSvc.CreateCheckoutSessionAsync(currentUser, planId, $"{page}?success=true", $"{page}?cancelled=true");
            if (string.IsNullOrEmpty(url))
                errorMessage = "Checkout could not be started. Please try again later.";
            else
                Nav.NavigateTo(url, forceLoad: true);
        }
        finally
        {
            busy = false;
        }
    }

    // Cancelling, changing card and switching plan all happen in Stripe's billing portal.
    private async Task ManageBilling()
    {
        if (currentUser == null || busy) return;
        busy = true;
        errorMessage = null;
        try
        {
            var url = await SubSvc.CreateCustomerPortalSessionAsync(currentUser, $"{Nav.BaseUri}profile/subscription");
            if (string.IsNullOrEmpty(url))
                errorMessage = "The billing portal could not be opened. Please try again later.";
            else
                Nav.NavigateTo(url, forceLoad: true);
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class PlanOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int SmsLimit { get; set; }
        public int VoiceLimit { get; set; }
        public bool Highlight { get; set; }
    }
}