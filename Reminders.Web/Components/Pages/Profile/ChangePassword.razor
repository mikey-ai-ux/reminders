@page "/profile/password"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager

@* Server-rendered on purpose: changing the password re-issues the sign-in cookie, which needs a normal HTTP response. *@

<PageTitle>Change password — Reminders</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon"><Icon Name="lock" Size="26" /></div>
            <h1>@(hasPassword ? "Change password" : "Set a password")</h1>
            <p>@(hasPassword ? "You'll stay signed in on this device." : "Add a password so you can also sign in with your email.")</p>
        </div>

        @if (succeeded)
        {
            <div class="alert alert-success"><Icon Name="check-circle" Size="16" /> Your password has been @(hasPassword ? "changed" : "set").</div>
            <a href="/profile" class="btn btn-primary btn-full">Back to account</a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-error" role="alert"><Icon Name="alert-triangle" Size="16" /> @errorMessage</div>
            }

            <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="change-password">
                <DataAnnotationsValidator />
                @if (hasPassword)
                {
                    <div class="form-group">
                        <label for="pw-current">Current password</label>
                        <InputText id="pw-current" @bind-Value="model.CurrentPassword" type="password" class="form-input" autocomplete="current-password" />
                    </div>
                }
                <div class="form-group">
                    <label for="pw-new">New password</label>
                    <InputText id="pw-new" @bind-Value="model.NewPassword" type="password" class="form-input" autocomplete="new-password" />
                    <ValidationMessage For="() => model.NewPassword" />
                </div>
                <div class="form-group">
                    <label for="pw-confirm">Repeat new password</label>
                    <InputText id="pw-confirm" @bind-Value="model.ConfirmPassword" type="password" class="form-input" autocomplete="new-password" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>
                <button type="submit" class="btn btn-primary btn-full">@(hasPassword ? "Change password" : "Set password")</button>
            </EditForm>

            <p class="auth-footer"><a href="/profile">Cancel</a></p>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private PasswordModel model { get; set; } = new();

    private AppUser? user;
    private bool hasPassword = true;
    private bool succeeded;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null) return;
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is not null) hasPassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task HandleSubmit()
    {
        if (user is null)
        {
            errorMessage = "Your session has expired. Please sign in again.";
            return;
        }

        IdentityResult result;
        if (hasPassword)
        {
            if (string.IsNullOrEmpty(model.CurrentPassword))
            {
                errorMessage = "Enter your current password.";
                return;
            }
            result = await UserManager.ChangePasswordAsync(user, model.CurrentPassword, model.NewPassword);
        }
        else
        {
            result = await UserManager.AddPasswordAsync(user, model.NewPassword);
        }

        if (result.Succeeded)
        {
            // The password change invalidates existing sign-ins; refresh this one so the user isn't logged out.
            await SignInManager.RefreshSignInAsync(user);
            succeeded = true;
            return;
        }

        errorMessage = result.Errors.Any(e => e.Code == "PasswordMismatch")
            ? "The current password is not correct."
            : string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class PasswordModel
    {
        public string? CurrentPassword { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter a new password.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
