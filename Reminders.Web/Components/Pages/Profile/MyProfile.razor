@page "/profile"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Reminders.Data.AppDbContext Db
@inject IVerificationSender VerificationSender
@inject IWebHostEnvironment Env
@inject IConfiguration Config
@rendermode InteractiveServer

<PageTitle>My Profile — Reminders</PageTitle>

@if (isLoading)
{
    <div class="card"><p>Loading profile…</p></div>
}
else if (currentUser is null)
{
    <div class="alert alert-error">Could not load your profile. Please sign in again.</div>
}
else
{
    <div class="profile-header">
        <div class="avatar">@GetInitial()</div>
        <div class="profile-info">
            <h1>@(currentUser.DisplayName ?? currentUser.Email ?? "User")</h1>
            <p class="profile-email">@currentUser.Email</p>
            <span class="tier-badge tier-@(currentUser.SubscriptionTier.ToString().ToLower())">@currentUser.SubscriptionTier Plan</span>
        </div>
    </div>

    <div class="profile-tabs">
        <button class="tab @(activeTab == "info" ? "active" : "")" @onclick='() => activeTab = "info"'>Registration Info</button>
        <button class="tab @(activeTab == "sub" ? "active" : "")" @onclick='() => activeTab = "sub"'>Subscription</button>
        <button class="tab @(activeTab == "history" ? "active" : "")" @onclick='() => activeTab = "history"'>Payment History</button>
    </div>

    @if (activeTab == "info")
    {
        <div class="tab-content card">
            <h2>Registration Info</h2>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-error" role="alert">@errorMessage</div>
            }
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success">@successMessage</div>
            }

            <EditForm Model="editModel" OnValidSubmit="SaveProfile" FormName="profile-edit">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>Name</label>
                    <InputText @bind-Value="editModel.DisplayName" class="form-input" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <InputText @bind-Value="editModel.Email" class="form-input" />
                    <div class="confirm-row">
                        <span class="badge @(currentUser.EmailConfirmed ? "badge-active" : "badge-paused")">
                            @(currentUser.EmailConfirmed ? "Email confirmed" : "Email not confirmed")
                        </span>
                        @if (!currentUser.EmailConfirmed)
                        {
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="GenerateEmailConfirmationLink">Send confirmation email</button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(emailConfirmationLink))
                    {
                        <div class="confirm-help">
                            <input class="form-input" readonly value="@emailConfirmationLink" />
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="CopyEmailLink">Copy link</button>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label>Phone</label>
                    <InputText @bind-Value="editModel.PhoneNumber" class="form-input" placeholder="+1 555 123 4567" />
                    <div class="confirm-row">
                        <span class="badge @((currentUser.PhoneNumberConfirmed) ? "badge-active" : "badge-paused")">
                            @(currentUser.PhoneNumberConfirmed ? "Phone confirmed" : "Phone not confirmed")
                        </span>
                        @if (!currentUser.PhoneNumberConfirmed && !string.IsNullOrWhiteSpace(editModel.PhoneNumber))
                        {
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="GeneratePhoneCode">Send code</button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(phoneCodeHint))
                    {
                        <div class="confirm-help">
                            <span class="badge badge-info">Code (dev): @phoneCodeHint</span>
                        </div>
                    }
                    @if (!currentUser.PhoneNumberConfirmed && !string.IsNullOrWhiteSpace(editModel.PhoneNumber))
                    {
                        <div class="confirm-help">
                            <InputText @bind-Value="phoneCodeInput" class="form-input" placeholder="Enter phone confirmation code" />
                            <button type="button" class="btn btn-sm btn-primary" @onclick="ConfirmPhoneCode">Confirm phone</button>
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label>Timezone</label>
                    <InputSelect @bind-Value="editModel.TimeZoneId" class="form-input">
                        @foreach (var tz in TimeZoneOptions.All)
                        {
                            <option value="@tz.Id">@tz.DisplayName</option>
                        }
                    </InputSelect>
                </div>

                <div class="confirm-row">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a href="/profile/password" class="btn btn-secondary"><Icon Name="lock" Size="15" /> Change password</a>
                </div>
            </EditForm>

            <div class="cal-subscribe card-section">
                <h3><Icon Name="calendar" Size="18" /> Calendar sync</h3>
                <p class="muted">Subscribe to this link in your phone or desktop calendar to see your reminders there. Anyone with the link can read them, so keep it private.</p>

                <div class="cal-url-box">
                    <input type="text" readonly value="@CalendarUrl" class="cal-url-input" />
                    <button class="btn btn-secondary" @onclick="CopyCalendarUrl"><Icon Name="@(copied ? "check" : "copy")" Size="15" /> @(copied ? "Copied" : "Copy link")</button>
                </div>
            </div>

            <div class="device-list card-section">
                <h3><Icon Name="smartphone" Size="18" /> Push devices</h3>
                <p class="muted">Push notifications are sent to each browser or phone you register.</p>
                <div class="confirm-help">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="RegisterThisDevice" disabled="@registeringDevice"><Icon Name="plus" Size="14" /> @(registeringDevice ? "Registering..." : "Register this device")</button>
                </div>
                @if (!pushDevices.Any())
                {
                    <p class="muted">No devices registered yet.</p>
                }
                else
                {
                    <ul class="devices">
                        @foreach (var d in pushDevices)
                        {
                            <li>
                                <div class="dev-main">
                                    <code>@ShortEndpoint(d.Endpoint)</code>
                                    <span class="muted">@d.DeviceType • Added @InUserZone(d.CreatedAt).ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-danger-ghost" @onclick="() => RemoveDevice(d.Id)">Remove</button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="device-list card-section">
                <h3><Icon Name="mail" Size="18" /> Extra email addresses and phone numbers</h3>
                <p class="muted">Add other addresses or numbers, confirm them, then pick them per reminder.</p>

                <div class="confirm-help">
                    <select class="form-input" @bind="newEndpointChannel">
                        <option value="Email">Email</option>
                        <option value="SMS">Phone</option>
                    </select>
                    <InputText class="form-input" @bind-Value="newEndpointValue" placeholder="email@example.com or +123..." />
                    <InputText class="form-input" @bind-Value="newEndpointLabel" placeholder="Label (Work, Personal, etc.)" />
                    <button type="button" class="btn btn-sm btn-primary" @onclick="AddEndpoint">Add endpoint</button>
                </div>

                @if (!contactEndpoints.Any())
                {
                    <p class="muted">No additional endpoints yet.</p>
                }
                else
                {
                    <ul class="devices">
                        @foreach (var ep in contactEndpoints)
                        {
                            <li>
                                <div class="dev-main">
                                    <code>@ep.Value</code>
                                    <span class="muted">@ep.Channel • @(string.IsNullOrWhiteSpace(ep.Label) ? "No label" : ep.Label) • @(ep.IsConfirmed ? "Confirmed" : "Unconfirmed")</span>
                                </div>
                                <div class="confirm-help">
                                    @if (!ep.IsConfirmed)
                                    {
                                        if (ep.Channel == Reminders.Models.Enums.NotificationChannel.Email)
                                        {
                                            <button type="button" class="btn btn-sm btn-secondary" @onclick="() => GenerateEndpointEmailLink(ep.Id)">Send confirmation email</button>
                                            @if (endpointEmailLinks.TryGetValue(ep.Id, out var link) && !string.IsNullOrWhiteSpace(link))
                                            {
                                                <button type="button" class="btn btn-sm btn-secondary" @onclick="() => CopyText(link)">Copy link</button>
                                            }
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-secondary" @onclick="() => GenerateEndpointPhoneCode(ep.Id)">Send code</button>
                                            <input class="form-input" value="@GetEndpointPhoneCode(ep.Id)" @onchange="(e) => SetEndpointPhoneCode(ep.Id, e.Value?.ToString())" placeholder="Code" />
                                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => ConfirmEndpointPhoneCode(ep.Id)">Confirm</button>
                                        }
                                    }
                                    <button type="button" class="btn btn-sm btn-danger-ghost" @onclick="() => RemoveEndpoint(ep.Id)">Remove</button>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
    @if (activeTab == "info")
    {
        <div class="danger-zone">
            <div>
                <h3>Delete account</h3>
                <p class="muted">Permanently removes your account, reminders and history.</p>
            </div>
            <a href="/profile/delete" class="btn btn-danger-outline"><Icon Name="trash" Size="15" /> Delete account</a>
        </div>
    }

    @if (activeTab == "sub")
    {
        <Subscription />
    }
    else if (activeTab == "history")
    {
        <PaymentHistory />
    }
}

<style>
.profile-header { display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.5rem; padding: 1.5rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 16px; }
.avatar { width: 64px; height: 64px; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 700; }
.profile-info h1 { margin: 0 0 0.2rem; }
.profile-email { margin: 0 0 0.4rem; color: var(--color-text-muted); }
.profile-tabs { display: flex; gap: .25rem; margin-bottom: 1rem; border-bottom: 1px solid var(--color-border); }
.tab { padding: .75rem 1rem; border-bottom: 2px solid transparent; color: var(--color-text-muted); }
.tab.active { color: var(--color-primary); border-bottom-color: var(--color-primary); font-weight: 600; }
.tab-content.card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 1.5rem; }
.confirm-row { margin-top: .45rem; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
.confirm-help { margin-top: .5rem; display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
.cal-subscribe { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
.cal-url-box { display: flex; gap: .5rem; margin-top: .75rem; }
.cal-url-input { flex: 1; font-size: .8rem; padding: .5rem .75rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-bg); color: var(--color-text-muted); font-family: monospace; }
.device-list { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
.devices { list-style: none; padding: 0; margin: .5rem 0 0; display: flex; flex-direction: column; gap: .5rem; }
.devices li { display: flex; justify-content: space-between; align-items: center; gap: .75rem; border: 1px solid var(--color-border); border-radius: 10px; padding: .6rem .7rem; background: var(--color-bg); }
.dev-main { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
.dev-main code { font-size: .75rem; overflow-wrap: anywhere; }
</style>

@code {
    private AppUser? currentUser;
    private bool isLoading = true;
    private string activeTab = "info";
    private string? successMessage;
    private string? errorMessage;
    private bool copied;

    [SupplyParameterFromQuery(Name = "confirm")]
    public string? ConfirmResult { get; set; }
    private string? emailConfirmationLink;
    private string? phoneCodeHint;
    private string phoneCodeInput = string.Empty;
    private List<PushSubscriptionRecord> pushDevices = new();
    private List<UserContactEndpoint> contactEndpoints = new();

    private string newEndpointChannel = "Email";
    private string newEndpointValue = string.Empty;
    private string newEndpointLabel = string.Empty;
    private Dictionary<int, string> endpointEmailLinks = new();
    private Dictionary<int, string> endpointPhoneCodes = new();

    private EditProfileModel editModel = new();
    private string CalendarUrl => $"{Nav.BaseUri}api/calendar/{currentUser?.Id}/reminders.ics";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(authState.User);

        if (currentUser is not null)
        {
            editModel.DisplayName = currentUser.DisplayName ?? string.Empty;
            editModel.Email = currentUser.Email ?? string.Empty;
            editModel.PhoneNumber = currentUser.PhoneNumber ?? string.Empty;
            editModel.TimeZoneId = TimeZoneOptions.Normalize(currentUser.TimeZoneId);

            (successMessage, errorMessage) = ConfirmResult switch
            {
                "email-ok" => ("Your email is confirmed.", (string?)null),
                "endpoint-ok" => ("The endpoint is confirmed and can now be used in reminders.", null),
                "endpoint-already" => ("That endpoint was already confirmed.", null),
                "email-failed" => (null, "That email confirmation link is invalid or has expired. Send a new one below."),
                "endpoint-failed" => (null, "That confirmation link is invalid or has expired. Send a new one below."),
                "endpoint-missing" => (null, "That endpoint no longer exists."),
                _ => ((string?)null, (string?)null)
            };

            pushDevices = Db.PushSubscriptions
                .Where(x => x.UserId == currentUser.Id)
                .OrderByDescending(x => x.CreatedAt)
                .ToList();

            contactEndpoints = Db.UserContactEndpoints
                .Where(x => x.UserId == currentUser.Id)
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }

        isLoading = false;
    }

    // Stored times are UTC; show them in the user's own timezone, not the server's.
    private DateTime InUserZone(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), RecurrenceCalculator.ResolveTimeZone(currentUser?.TimeZoneId));

    private string GetInitial() => (currentUser?.DisplayName ?? currentUser?.Email ?? "?").FirstOrDefault().ToString().ToUpperInvariant();

    private async Task CopyCalendarUrl()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", CalendarUrl);
        copied = true;
        await Task.Delay(1500);
        copied = false;
    }

    private void Ok(string message) { successMessage = message; errorMessage = null; }
    private void Fail(string message) { errorMessage = message; successMessage = null; }

    // Confirmation links and codes prove the user owns the address, so they are only ever shown
    // on screen in Development. Everywhere else they must arrive by email or SMS.
    private bool RevealSecrets => Env.IsDevelopment();

    private static string NewCode() => System.Security.Cryptography.RandomNumberGenerator.GetInt32(100000, 1000000).ToString();

    private static bool TryNormalizePhone(string? input, out string phone)
    {
        phone = new string((input ?? string.Empty).Where(c => !char.IsWhiteSpace(c) && c is not ('-' or '(' or ')' or '.')).ToArray());
        if (phone.StartsWith("00", StringComparison.Ordinal)) phone = "+" + phone[2..];
        return System.Text.RegularExpressions.Regex.IsMatch(phone, "^\\+[1-9]\\d{7,14}$");
    }

    private async Task GenerateEmailConfirmationLink()
    {
        if (currentUser is null || string.IsNullOrWhiteSpace(currentUser.Email)) return;

        var token = await UserManager.GenerateEmailConfirmationTokenAsync(currentUser);
        var link = $"{Nav.BaseUri}confirm-email?userId={Uri.EscapeDataString(currentUser.Id)}&code={Uri.EscapeDataString(token)}";

        var sent = await VerificationSender.SendEmailAsync(currentUser.Email, "Confirm your Reminders email", $"Please confirm your email by opening this link: {link}");
        emailConfirmationLink = RevealSecrets ? link : null;

        if (sent) Ok("Confirmation email sent. Open the link in it to confirm.");
        else if (RevealSecrets) Ok("Email delivery is not set up, so the confirmation link is shown below (development only).");
        else Fail("The confirmation email could not be sent. Email delivery is not set up on this server yet.");
    }

    private async Task CopyEmailLink()
    {
        if (!string.IsNullOrWhiteSpace(emailConfirmationLink))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", emailConfirmationLink);
    }

    private async Task GeneratePhoneCode()
    {
        if (currentUser is null) return;
        if (!TryNormalizePhone(editModel.PhoneNumber, out var phone))
        {
            Fail("Invalid phone format. Use international format like +123456789 (or 00...).");
            return;
        }
        editModel.PhoneNumber = phone;

        var code = await UserManager.GenerateChangePhoneNumberTokenAsync(currentUser, phone);
        var sent = await VerificationSender.SendSmsAsync(phone, $"Your Reminders confirmation code is {code}");
        phoneCodeHint = RevealSecrets ? code : null;

        if (sent) Ok("We sent a confirmation code by SMS. Enter it below.");
        else if (RevealSecrets) Ok("SMS delivery is not set up, so the code is shown below (development only).");
        else Fail("The confirmation code could not be sent. SMS delivery is not set up on this server yet.");
    }

    private async Task ConfirmPhoneCode()
    {
        if (currentUser is null || string.IsNullOrWhiteSpace(phoneCodeInput)) return;
        if (!TryNormalizePhone(editModel.PhoneNumber, out var phone))
        {
            Fail("Invalid phone format. Use international format like +123456789 (or 00...).");
            return;
        }

        // ChangePhoneNumberAsync would also rotate the security stamp, which signs the user out of this
        // session a few minutes later; verify the code and store the number directly instead.
        if (!await UserManager.VerifyChangePhoneNumberTokenAsync(currentUser, phoneCodeInput.Trim(), phone))
        {
            Fail("Invalid or expired phone code.");
            return;
        }

        var previous = (currentUser.PhoneNumber, currentUser.PhoneNumberConfirmed);
        currentUser.PhoneNumber = phone;
        currentUser.PhoneNumberConfirmed = true;
        var result = await UserManager.UpdateAsync(currentUser);
        if (result.Succeeded)
        {
            editModel.PhoneNumber = phone;
            phoneCodeInput = string.Empty;
            phoneCodeHint = null;
            Ok("Phone confirmed successfully.");
        }
        else
        {
            (currentUser.PhoneNumber, currentUser.PhoneNumberConfirmed) = previous;
            Fail(string.Join(" ", result.Errors.Select(e => e.Description)));
        }
    }

    private bool registeringDevice;

    private async Task RegisterThisDevice()
    {
        if (currentUser is null || registeringDevice) return;
        registeringDevice = true;
        try
        {
            var vapidPublic = Config["Vapid:PublicKey"];
            if (string.IsNullOrWhiteSpace(vapidPublic) || vapidPublic.Contains("YOUR_"))
            {
                Fail("Push notifications are not set up on this server yet.");
                return;
            }

            if (!await JS.InvokeAsync<bool>("canRegisterPushVapid"))
            {
                Fail("This browser can't receive push notifications.");
                return;
            }

            if (await JS.InvokeAsync<bool>("registerPushSubscription", vapidPublic))
            {
                pushDevices = Db.PushSubscriptions.AsNoTracking()
                    .Where(x => x.UserId == currentUser.Id)
                    .OrderByDescending(x => x.CreatedAt)
                    .ToList();
                Ok("This device is registered for push notifications.");
            }
            else
            {
                Fail("Could not register this device. Allow notifications for this site and try again.");
            }
        }
        catch (JSException)
        {
            Fail("Could not register this device. Allow notifications for this site and try again.");
        }
        finally
        {
            registeringDevice = false;
        }
    }

    private string ShortEndpoint(string endpoint)
    {
        if (string.IsNullOrWhiteSpace(endpoint)) return "(unknown)";
        return endpoint.Length > 80 ? endpoint[..80] + "…" : endpoint;
    }

    private async Task RemoveDevice(int id)
    {
        var sub = Db.PushSubscriptions.FirstOrDefault(x => x.Id == id && currentUser != null && x.UserId == currentUser.Id);
        if (sub == null) return;

        Db.PushSubscriptions.Remove(sub);
        await Db.SaveChangesAsync();

        pushDevices = pushDevices.Where(x => x.Id != id).ToList();
    }

    private async Task AddEndpoint()
    {
        if (currentUser is null) return;
        if (string.IsNullOrWhiteSpace(newEndpointValue)) return;

        var channel = newEndpointChannel == "Email" ? Reminders.Models.Enums.NotificationChannel.Email : Reminders.Models.Enums.NotificationChannel.SMS;
        var value = newEndpointValue.Trim();

        if (channel == Reminders.Models.Enums.NotificationChannel.Email)
        {
            if (value.Length > 320 || !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(value))
            {
                Fail("Invalid email format.");
                return;
            }
        }
        else if (!TryNormalizePhone(value, out value))
        {
            Fail("Invalid phone format. Use international format like +123456789 (or 00...).");
            return;
        }

        var label = string.IsNullOrWhiteSpace(newEndpointLabel) ? null : newEndpointLabel.Trim();
        if (label is { Length: > 100 })
        {
            Fail("Label must be 100 characters or fewer.");
            return;
        }

        var exists = Db.UserContactEndpoints.Any(x => x.UserId == currentUser.Id && x.Channel == channel && x.Value == value);
        if (exists)
        {
            Fail("Endpoint already exists.");
            return;
        }

        var ep = new UserContactEndpoint
        {
            UserId = currentUser.Id,
            Channel = channel,
            Value = value,
            Label = label,
            IsConfirmed = false,
            VerificationToken = Guid.NewGuid().ToString("N"),
            VerificationCode = NewCode(),
            VerificationExpiresAtUtc = DateTime.UtcNow.AddMinutes(30),
            CreatedAt = DateTime.UtcNow
        };

        Db.UserContactEndpoints.Add(ep);
        await Db.SaveChangesAsync();

        contactEndpoints.Insert(0, ep);
        newEndpointValue = string.Empty;
        newEndpointLabel = string.Empty;
        Ok("Endpoint added. Please confirm it before using it in reminders.");
    }

    private async Task GenerateEndpointEmailLink(int id)
    {
        var ep = Db.UserContactEndpoints.FirstOrDefault(x => x.Id == id && currentUser != null && x.UserId == currentUser.Id && x.Channel == Reminders.Models.Enums.NotificationChannel.Email);
        if (ep == null) return;

        ep.VerificationToken = Guid.NewGuid().ToString("N");
        ep.VerificationExpiresAtUtc = DateTime.UtcNow.AddMinutes(30);
        await Db.SaveChangesAsync();

        var link = $"{Nav.BaseUri}confirm-contact-endpoint?endpointId={id}&token={ep.VerificationToken}";
        var sent = await VerificationSender.SendEmailAsync(ep.Value, "Confirm your additional Reminders endpoint", $"Please confirm this endpoint by opening this link: {link}");

        if (RevealSecrets) endpointEmailLinks[id] = link; else endpointEmailLinks.Remove(id);

        if (sent) Ok($"Confirmation email sent to {ep.Value}.");
        else if (RevealSecrets) Ok("Email delivery is not set up, so use Copy link to confirm (development only).");
        else Fail("The confirmation email could not be sent. Email delivery is not set up on this server yet.");
    }

    private async Task GenerateEndpointPhoneCode(int id)
    {
        var ep = Db.UserContactEndpoints.FirstOrDefault(x => x.Id == id && currentUser != null && x.UserId == currentUser.Id && x.Channel == Reminders.Models.Enums.NotificationChannel.SMS);
        if (ep == null) return;

        ep.VerificationCode = NewCode();
        ep.VerificationExpiresAtUtc = DateTime.UtcNow.AddMinutes(30);
        await Db.SaveChangesAsync();

        var sent = await VerificationSender.SendSmsAsync(ep.Value, $"Your Reminders confirmation code is {ep.VerificationCode}");

        if (sent) Ok($"We sent a confirmation code by SMS to {ep.Value}.");
        else if (RevealSecrets) Ok($"SMS delivery is not set up. Phone verification code (development only): {ep.VerificationCode}");
        else Fail("The confirmation code could not be sent. SMS delivery is not set up on this server yet.");
    }

    private async Task ConfirmEndpointPhoneCode(int id)
    {
        var ep = Db.UserContactEndpoints.FirstOrDefault(x => x.Id == id && currentUser != null && x.UserId == currentUser.Id && x.Channel == Reminders.Models.Enums.NotificationChannel.SMS);
        if (ep == null) return;

        endpointPhoneCodes.TryGetValue(id, out var input);
        if (string.IsNullOrWhiteSpace(input) || string.IsNullOrWhiteSpace(ep.VerificationCode) || !string.Equals(input.Trim(), ep.VerificationCode, StringComparison.Ordinal) || (ep.VerificationExpiresAtUtc.HasValue && ep.VerificationExpiresAtUtc.Value < DateTime.UtcNow))
        {
            Fail("Invalid or expired phone verification code.");
            return;
        }

        ep.IsConfirmed = true;
        ep.VerificationCode = null;
        ep.VerificationExpiresAtUtc = null;
        await Db.SaveChangesAsync();

        var inList = contactEndpoints.FirstOrDefault(x => x.Id == id);
        if (inList != null) inList.IsConfirmed = true;
        endpointPhoneCodes[id] = string.Empty;
        Ok("Phone endpoint confirmed.");
    }

    private async Task CopyText(string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
    }

    private string GetEndpointPhoneCode(int id)
        => endpointPhoneCodes.TryGetValue(id, out var code) ? code : string.Empty;

    private void SetEndpointPhoneCode(int id, string? code)
        => endpointPhoneCodes[id] = code ?? string.Empty;

    private async Task RemoveEndpoint(int id)
    {
        var ep = Db.UserContactEndpoints.FirstOrDefault(x => x.Id == id && currentUser != null && x.UserId == currentUser.Id);
        if (ep == null) return;

        Db.UserContactEndpoints.Remove(ep);
        await Db.SaveChangesAsync();

        contactEndpoints = contactEndpoints.Where(x => x.Id != id).ToList();
    }

    private async Task SaveProfile()
    {
        if (currentUser is null) return;

        var email = (editModel.Email ?? string.Empty).Trim();
        if (email.Length == 0 || !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email))
        {
            Fail("Please enter a valid email address.");
            return;
        }

        var phone = string.Empty;
        if (!string.IsNullOrWhiteSpace(editModel.PhoneNumber) && !TryNormalizePhone(editModel.PhoneNumber, out phone))
        {
            Fail("Invalid phone format. Use international format like +123456789 (or 00...).");
            return;
        }

        var emailChanged = !string.Equals(currentUser.Email, email, StringComparison.OrdinalIgnoreCase);
        if (emailChanged)
        {
            var owner = await UserManager.FindByEmailAsync(email);
            if (owner is not null && owner.Id != currentUser.Id)
            {
                Fail("That email address is already used by another account.");
                return;
            }
        }

        // Keep the old values so a rejected update doesn't leave the page showing unsaved changes.
        var before = (currentUser.DisplayName, currentUser.TimeZoneId, currentUser.Email, currentUser.UserName, currentUser.EmailConfirmed, currentUser.PhoneNumber, currentUser.PhoneNumberConfirmed);

        currentUser.DisplayName = string.IsNullOrWhiteSpace(editModel.DisplayName) ? null : editModel.DisplayName.Trim();
        currentUser.TimeZoneId = TimeZoneOptions.Normalize(editModel.TimeZoneId);

        if (emailChanged)
        {
            currentUser.Email = email;
            currentUser.UserName = email;
            currentUser.EmailConfirmed = false; // requires confirmation again
            emailConfirmationLink = null;
        }

        var phoneChanged = !string.Equals(currentUser.PhoneNumber ?? string.Empty, phone, StringComparison.Ordinal);
        if (phoneChanged)
        {
            currentUser.PhoneNumber = phone.Length == 0 ? null : phone;
            currentUser.PhoneNumberConfirmed = false; // requires confirmation again
            phoneCodeHint = null;
        }

        var result = await UserManager.UpdateAsync(currentUser);
        if (result.Succeeded)
        {
            editModel.Email = email;
            editModel.PhoneNumber = phone;
            Ok(emailChanged || phoneChanged
                ? "Profile saved. Confirm your new email/phone before using it in reminders."
                : "Profile saved.");
        }
        else
        {
            (currentUser.DisplayName, currentUser.TimeZoneId, currentUser.Email, currentUser.UserName, currentUser.EmailConfirmed, currentUser.PhoneNumber, currentUser.PhoneNumberConfirmed) = before;
            Fail(string.Join(" ", result.Errors.Select(e => e.Description)));
        }
    }

    private sealed class EditProfileModel
    {
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string TimeZoneId { get; set; } = "UTC";
    }
}
