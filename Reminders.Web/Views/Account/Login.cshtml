@{
    Layout = null;
    var error = ViewData["Error"] as string;
    var email = ViewData["Email"] as string;
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/reminders";
    var theme = ViewData["Theme"] as string ?? "dark";
    var providers = ViewData["ExternalProviders"] as IReadOnlyList<string> ?? Array.Empty<string>();
}
<!doctype html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign In — Reminders</title>
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <link rel="stylesheet" href="/css/app.css" />
    <style>
        .password-row { display: flex; gap: .5rem; align-items: center; }
        .password-row .form-input { flex: 1; }
        .auth-home { display: block; text-align: center; margin-bottom: 1rem; }
    </style>
</head>
<body>
<div class="auth-container">
    <div class="auth-card">
        <a class="auth-home brand-link" href="/"><span class="brand-badge"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/><path d="M22 8c0-2.3-.8-4.3-2-6"/></svg></span><span class="brand-text">Reminders</span></a>
        <div class="auth-header">
            <div class="auth-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
            <h1>Welcome back</h1>
            <p>Sign in to your Reminders account</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-error" role="alert">@error</div>
        }

        <form method="post" action="/account/login">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="form-group">
                <label for="email">Email</label>
                <input id="email" name="email" class="form-input" type="email" value="@email" autocomplete="username" required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="password-row">
                    <input id="password" name="password" class="form-input" type="password" autocomplete="current-password" required />
                    <button type="button" class="btn btn-ghost btn-sm" onclick="togglePass(this)">Show</button>
                </div>
            </div>

            <div class="form-check">
                <span><input id="remember" name="rememberMe" type="checkbox" value="true" /> <label for="remember">Remember me</label></span>
                <a href="/forgot-password">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary btn-full">Sign In</button>
        </form>

        @if (providers.Count > 0)
        {
            <div class="divider"><span>or continue with</span></div>
            <div class="social-buttons">
                @foreach (var provider in providers)
                {
                    <a href="/challenge/@provider?returnUrl=@Uri.EscapeDataString(returnUrl)" class="btn btn-social">@provider</a>
                }
            </div>
        }

        <p class="auth-footer">Don't have an account? <a href="/register">Sign up free</a></p>
    </div>
</div>
<script>
function togglePass(btn){
  const i = document.getElementById('password');
  if(!i) return;
  i.type = i.type === 'password' ? 'text' : 'password';
  btn.textContent = i.type === 'password' ? 'Show' : 'Hide';
}
</script>
</body>
</html>
